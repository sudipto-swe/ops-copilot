# Core App Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Target Services Ports
GATEWAY_PORT=8001
ORDERS_PORT=8002
PAYMENTS_PORT=8003
API_PORT=8000
PROMETHEUS_PORT=9090

# Target Service URLs
GATEWAY_URL=http://localhost:8001
ORDERS_URL=http://localhost:8002
PAYMENTS_URL=http://localhost:8003
PROMETHEUS_URL=http://localhost:9090

# LLM Configuration
# Providers: mock | ollama | gemini | groq | openrouter
LLM_PROVIDER=mock
LLM_MODEL=mock-ops-v1
LLM_CACHE_DIR=.cache/llm_responses
LLM_MAX_RETRIES=3
LLM_BACKOFF_FACTOR=1.5

# Optional API Keys (Zero-cost free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Safety & Audit
AUDIT_LOG_PATH=logs/audit.jsonl
SECRET_REDACTION_ENABLED=true
DRY_RUN_DEFAULT=true
APPROVAL_SECRET=change-me-in-production-ops-copilot-secret
